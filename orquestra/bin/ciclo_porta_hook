#!/usr/bin/env bash
. "$(dirname -- "${BASH_SOURCE[0]}")/orchestra-env.sh"
export PATH="$ORCHESTRA_BIN:$HOME/.local/bin:$PATH"
entrada=$(cat)
expiry=$(cat "$ORCHESTRA_STATE/CICLO_LIBERADO" 2>/dev/null)
if [[ "$expiry" =~ ^[0-9]+$ ]] && (( expiry <= ${AGORA:-$(date +%s)} )); then rm -f "$ORCHESTRA_STATE/CICLO_LIBERADO"; fi
O="$ORCHESTRA_STATE"
if python3 -c 'import json,os,sys
prompt=json.loads(sys.argv[1]).get("prompt", "")
owner=os.environ.get("ORCHESTRA_OPERATOR_LABEL", "Operator")
sys.exit(0 if prompt.casefold().startswith((owner+":").casefold()) or prompt.startswith("[Recado do "+owner) else 1)' "$entrada"; then
    manha=$(cat "$O/ciclo.manha" 2>/dev/null); manha=${manha%%.*}; agora=$(date +%s)
    if [[ $manha =~ ^[0-9]+$ ]] && (( agora >= manha && agora < manha + 18000 )) && [[ ! -e "$O/CICLO_LIBERADO" ]]; then
        echo $((manha + 18000)) > "$O/CICLO_LIBERADO"
        grep -q teto "$O/PORTA_FECHADA" 2>/dev/null && rm -f "$O/PORTA_FECHADA"
        echo "$(date '+%F %T') operator começou a usar: teto da manhã removido até $(date -d "@$((manha + 18000))" +%H:%M)" >> "$O/ciclo.log"
    fi
    exit 0
fi
if [[ -e "$O/PORTA_FECHADA" && ${CICLO_ANCORA:-} != 1 && ! -e "$O/CICLO_LIBERADO" ]]; then
    grep -Eq '"prompt"[[:space:]]*:[[:space:]]*"RESUMO DA MANHA' <<< "$entrada" && exit 0
    if [[ -s "$O/porta_excecoes" ]]; then
        python3 -I -c '
import json,sys,time
cwd=json.loads(sys.argv[1]).get("cwd","")
for l in open(sys.argv[2]):
    p,_,v=l.strip().rpartition("|")
    if p and v.isdigit() and int(v)>time.time() and (cwd==p or cwd.startswith(p+"/")): sys.exit(0)
sys.exit(1)' "$entrada" "$O/porta_excecoes" 2>/dev/null && exit 0
    fi
    printf '%s %s\n' "$(date '+%F %T')" "$(tr -d '\n' <<< "$entrada" | head -c 200)" >> "$O/porta_bloqueados.log" 2>/dev/null
    ate=$(head -c 80 "$O/PORTA_FECHADA" | tr -d '"\\\n')
    if [[ -z $ate ]]; then
        ate=05:00
        if [[ -f "$O/ciclo.conf" ]]; then
            while IFS= read -r linha; do
                [[ $linha =~ ^ANCORA=([0-9]{2}:[0-9]{2})$ ]] && ate=${BASH_REMATCH[1]}
            done < "$O/ciclo.conf"
        fi
    fi
    printf '{"decision":"block","reason":"porta do ciclo fechada até %s"}\n' "$ate"
fi
exit 0
